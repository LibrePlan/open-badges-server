#
# Run the badge server's "flask" administration commands as the "badges"
# system user, with the environment from badges.env.
#
# Usage:  sudo ./deploy/badgectl <command> [args...]
# Example: sudo ./deploy/badgectl create-admin admin
#          sudo ./deploy/badgectl set-issuer --name "Acme" --url https://acme.example --email badges@acme.example

set -euo pipefail

ENV_FILE="${BADGES_ENV_FILE:-/var/lib/badgeserver/badges.env}"
REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ $EUID -ne 0 ]]; then
  echo "badgectl: run with sudo (it switches to the 'badges' user itself)" >&2
  exit 1
fi
if [[ ! -r "$ENV_FILE" ]]; then
  echo "badgectl: $ENV_FILE not found." >&2
  echo "          create it:  sudo install -o root -g badges -m 0640 \\" >&2
  echo "                        '$REPO_DIR/deploy/badges.env.example' $ENV_FILE" >&2
  echo "          then edit it: sudoedit $ENV_FILE" >&2
  exit 1
fi

# The 'badges' user must be able to read the checkout. A checkout under a
# private home directory (/home/<user>, mode 0700) is NOT reachable -- move it
# somewhere world-traversable such as /opt/badgeserver. See Docs/INSTALL.md.
if ! sudo -u badges test -r "$REPO_DIR/wsgi.py"; then
  echo "badgectl: the 'badges' user cannot read $REPO_DIR/wsgi.py" >&2
  echo "          move this checkout outside a private home dir, e.g.:" >&2
  echo "            sudo rsync -a --delete '$REPO_DIR/' /opt/badgeserver/" >&2
  echo "          then run  sudo /opt/badgeserver/deploy/badgectl $*" >&2
  exit 1
fi

# Load the env file without letting it run arbitrary code: only KEY=VALUE lines
# are honoured, the value is taken verbatim (spaces and "<>" are fine), and an
# optional pair of surrounding double quotes is stripped (systemd does the same).
while IFS='=' read -r _key _val; do
  [[ "$_key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
  if [[ "$_val" == \"*\" ]]; then _val="${_val#\"}"; _val="${_val%\"}"; fi
  export "$_key=$_val"
done < <(grep -E '^[A-Za-z_][A-Za-z0-9_]*=' "$ENV_FILE")

: "${BADGESERVER_DATA_DIR:=/var/lib/badgeserver}"

# Required values must be filled in before anything will load.
_missing=()
[[ -n "${SECRET_KEY:-}" ]]   || _missing+=(SECRET_KEY)
[[ -n "${EXTERNAL_URL:-}" ]] || _missing+=(EXTERNAL_URL)
if (( ${#_missing[@]} )); then
  echo "badgectl: ${_missing[*]} still unset in $ENV_FILE -- edit it first:" >&2
  echo "          sudoedit $ENV_FILE" >&2
  echo "          SECRET_KEY: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'" >&2
  echo "          EXTERNAL_URL: e.g. http://badges.dsg.lan:4000" >&2
  exit 1
fi

# Run from "/" (a directory the badges user can always stat) so Flask's dotenv
# lookup does not choke, and skip that lookup entirely -- config comes from the
# env file above, not from a .env in the tree.
exec sudo -u badges env -C / \
    HOME="$BADGESERVER_DATA_DIR" \
    FLASK_SKIP_DOTENV=1 \
    PYTHONPATH="$REPO_DIR" \
    BADGESERVER_DATA_DIR="$BADGESERVER_DATA_DIR" \
    SECRET_KEY="${SECRET_KEY:-}" \
    EXTERNAL_URL="${EXTERNAL_URL:-}" \
    DATABASE_URL="${DATABASE_URL:-}" \
    SITE_TITLE="${SITE_TITLE:-}" \
    MAIL_ENABLED="${MAIL_ENABLED:-}" \
    SMTP_HOST="${SMTP_HOST:-}" \
    SMTP_PORT="${SMTP_PORT:-}" \
    SMTP_SECURITY="${SMTP_SECURITY:-}" \
    SMTP_USERNAME="${SMTP_USERNAME:-}" \
    SMTP_PASSWORD="${SMTP_PASSWORD:-}" \
    SMTP_TIMEOUT="${SMTP_TIMEOUT:-}" \
    MAIL_FROM="${MAIL_FROM:-}" \
    MAIL_REPLY_TO="${MAIL_REPLY_TO:-}" \
    FLASK_APP="$REPO_DIR/wsgi.py" \
  python3 -m flask "$@"
