#
# This unit has ONE path to set for your host: WorkingDirectory, the checkout
# of this repository. Everything else is derived from it or lives in
# /var/lib/badgeserver (created by StateDirectory=).
#
# The checkout must be readable by the unprivileged "badges" user, so it must
# NOT sit under a private home directory (/home/<user>, mode 0700). Put it in
# /opt/badgeserver or similar. See Docs/INSTALL.md.
#
# Install (substitutes the repo path in one step -- run from the checkout):
#   sudo sed "s#__REPO__#$PWD#" deploy/badgeserver.service \
#     | sudo tee /etc/systemd/system/badgeserver.service > /dev/null
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now badgeserver

[Unit]
Description=Self-hosted Open Badges 2.0 issuer
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=badges
Group=badges
WorkingDirectory=__REPO__
StateDirectory=badgeserver
Environment=BADGESERVER_DATA_DIR=/var/lib/badgeserver
EnvironmentFile=/var/lib/badgeserver/badges.env
ExecStart=/usr/bin/python3 -m gunicorn -c deploy/gunicorn.conf.py wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=3

# --- hardening ---
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/badgeserver
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
