#
# Example Apache reverse-proxy vhost for the badge server.
#
#   sudo a2enmod proxy proxy_http headers ssl
#   sudo systemctl restart apache2        # a full restart -- new modules
#   sudo certbot certonly --apache -d badges.example.org   # cert first (see below)
#   sudo cp deploy/apache-badges.conf.example /etc/apache2/sites-available/badges.conf
#   sudoedit /etc/apache2/sites-available/badges.conf    # ServerName + cert paths
#   sudo a2ensite badges && sudo apache2ctl configtest && sudo systemctl reload apache2
#
# Modules this vhost needs:
#   proxy        core reverse-proxy engine
#   proxy_http   handle http:// backends -- without it: "AH01144: No protocol
#                handler was valid for the URL / (scheme 'http')"
#   headers      the "RequestHeader set X-Forwarded-Proto" line -- without it:
#                "Invalid command 'RequestHeader'"
#   ssl          the <VirtualHost *:443> / SSL* directives
#   (mod_alias, for the port-80 Redirect, is enabled by default)
# Check what is loaded:  apache2ctl -M | grep -E 'proxy|headers|ssl'
#
# Get the certificate BEFORE enabling this site -- `apache2ctl configtest`
# fails while SSLCertificateFile points at a path that does not exist yet.
# `certbot certonly --apache` obtains it without touching this vhost.
# See Docs/INSTALL.md section 6b.

<VirtualHost *:80>
    ServerName badges.example.org
    Redirect permanent / https://badges.example.org/
</VirtualHost>

<VirtualHost *:443>
    ServerName badges.example.org

    SSLEngine on
    SSLCertificateFile      /etc/letsencrypt/live/badges.example.org/fullchain.pem
    SSLCertificateKeyFile   /etc/letsencrypt/live/badges.example.org/privkey.pem

    # Pass the real scheme/host so the app builds correct absolute URLs.
    RequestHeader set X-Forwarded-Proto "https"
    ProxyPreserveHost On
    ProxyPass        /  http://127.0.0.1:4000/  timeout=30
    ProxyPassReverse /  http://127.0.0.1:4000/

    # Uploaded badge art can be a few hundred KB; keep the default body limit.
    LimitRequestBody 4194304

    ErrorLog  ${APACHE_LOG_DIR}/badges-error.log
    CustomLog ${APACHE_LOG_DIR}/badges-access.log combined
</VirtualHost>
