#
# Copy to /var/lib/badgeserver/badges.env and edit.
#   sudo install -o root -g badges -m 0640 deploy/badges.env.example /var/lib/badgeserver/badges.env
#   sudoedit /var/lib/badgeserver/badges.env
#
# Only KEY=VALUE lines are read. Do not add shell syntax.

# --- required ---------------------------------------------------------------

# Long random string. Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Public origin the badges are served from (no trailing slash).
# This MUST match what recipients and validators see through the reverse proxy.
EXTERNAL_URL=https://badges.example.org

# --- appearance ------------------------------------------------------------

SITE_TITLE=Open Badges

# --- reverse proxy --------------------------------------------------------

# Number of trusted proxy hops (1 for a single nginx/apache in front).
PROXY_FIX_HOPS=1
# Set to false only for local http testing without a proxy.
SESSION_COOKIE_SECURE=true

# --- e-mail (award notifications) ----------------------------------------

MAIL_ENABLED=true
SMTP_HOST=smtp.example.org
SMTP_PORT=587
# one of: none | starttls | ssl
SMTP_SECURITY=starttls
SMTP_USERNAME=badges@example.org
SMTP_PASSWORD=
MAIL_FROM=Open Badges <badges@example.org>
# Optional:
MAIL_REPLY_TO=

# --- limits (optional) --------------------------------------------------

# RATELIMIT_LOGIN=5 per minute; 30 per hour
# CSV_AWARD_MAX_ROWS=200
# MAX_UPLOAD_BYTES=3145728
# BADGE_IMAGE_SIZE=512
